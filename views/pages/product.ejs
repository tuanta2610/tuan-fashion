<%
  const name = L(product.name);
  const detailCrop = '&crop=focalpoint&fp-x=0.5&fp-y=0.4&fp-z=2.2';
%>
<%- include('../partials/top', {
  title: name,
  description: L(product.description),
  ogImage: img(product.image, 1200, 630),
  ogType: 'product',
  head: `<script type="application/ld+json">${JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name,
    description: L(product.description),
    image: img(product.image, 1200),
    brand: { '@type': 'Brand', name: 'TUAN FASHION' },
    material: L(product.material),
    offers: { '@type': 'Offer', priceCurrency: 'VND', price: product.price, availability: 'https://schema.org/InStoreOnly' },
  })}</script>`
}) %>

<div class="container">
  <nav class="breadcrumb" aria-label="<%= t('product.breadcrumb') %>">
    <ol>
      <li><a href="<%= url('/collections') %>"><%= t('nav.collections') %></a></li>
      <li><a href="<%= url('/collections?category=' + product.category) %>"><%= t('categories.' + product.category) %></a></li>
      <li aria-current="page"><%= name %></li>
    </ol>
  </nav>
</div>

<section class="container product">
  <div class="product-gallery" aria-label="<%= t('product.gallery') %>">
    <figure>
      <img src="<%= img(product.image, 1200, 1600) %>" srcset="<%= srcset(product.image, 1.3333) %>"
           sizes="(min-width: 1024px) 55vw, 100vw" alt="<%= name %>" width="1200" height="1600" fetchpriority="high">
    </figure>
    <% if (!product.image.startsWith('/')) { %>
    <figure>
      <img src="<%= img(product.image, 1200, 1200, detailCrop) %>" alt="<%= name %> — <%= t('product.detailView') %>"
           width="1200" height="1200" loading="lazy">
      <figcaption class="small muted"><%= t('product.detailView') %></figcaption>
    </figure>
    <% } %>
  </div>

  <div class="product-info">
    <div class="product-sticky">
      <p class="eyebrow"><%= t('categories.' + product.category) %></p>
      <h1 class="h1"><%= name %></h1>
      <p class="product-price"><%= price(product.price) %></p>
      <p class="small muted"><%= t('product.priceNote') %></p>

      <p class="product-desc"><%= L(product.description) %></p>

      <dl class="spec">
        <dt><%= t('product.material') %></dt>
        <dd><%= L(product.material) %></dd>
      </dl>

      <div class="btn-stack">
        <a class="btn btn-primary btn-block" href="<%= url('/appointment?piece=' + product.slug) %>">
          <%= t('product.bookFitting') %> <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg>
        </a>
        <a class="btn btn-outline btn-block" href="<%= site.zalo %>" target="_blank" rel="noopener">
          <svg class="icon" aria-hidden="true"><use href="#i-chat"/></svg> <%= t('product.askZalo') %>
        </a>
      </div>

      <div class="accordion">
        <details open>
          <summary><%= t('product.details') %><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></summary>
          <ul class="dash-list"><% L(product.details).forEach((d) => { %><li><%= d %></li><% }) %></ul>
        </details>
        <details>
          <summary><%= t('product.care') %><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></summary>
          <p><%= t('product.careText') %></p>
        </details>
        <details>
          <summary><%= t('product.delivery') %><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></summary>
          <p><%= t('product.deliveryText') %></p>
        </details>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="h2 reveal"><%= t('product.related') %></h2>
      <a class="btn-text reveal" href="<%= url('/collections') %>"><%= t('product.back') %></a>
    </div>
    <div class="grid grid-3">
      <% related.forEach((p) => { %><%- include('../partials/product-card', { p }) %><% }) %>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
