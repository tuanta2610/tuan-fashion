# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env lên GitHub.
NODE_ENV=production
PORT=3000

# Tên miền chính thức (dùng cho SEO, sitemap, thẻ chia sẻ mạng xã hội)
SITE_URL=https://tuanfashion.com

# SMTP — với email Hostinger: smtp.hostinger.com, cổng 465
# Với Gmail: smtp.gmail.com, cổng 465, SMTP_PASS là "App Password" 16 ký tự (không phải mật khẩu Gmail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=booking@tuanfashion.com
SMTP_PASS=

# Hộp thư nhận lịch hẹn / liên hệ
MAIL_TO=tuantran261083@gmail.com
# Tên + địa chỉ người gửi (phải trùng tài khoản SMTP_USER với hầu hết nhà cung cấp)
MAIL_FROM="TUAN FASHION" <booking@tuanfashion.com>

# Gửi email xác nhận tự động cho khách (true/false)
AUTO_REPLY=true
